# 90 Meclis — ortam değişkenleri örneği. Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env dosyası .gitignore'dadır; GERÇEK ANAHTARLARI DEPOYA KOYMAYIN.

# Supabase (Project Settings > API). Bot/GitHub Actions için service_role, herkese açık okuma için anon anahtarı.
SUPABASE_URL=https://<proje-ref>.supabase.co
SUPABASE_KEY=<service_role_veya_anon_anahtari>

# Opsiyonel veri kaynakları (boş bırakılırsa ilgili veri gösterilmez; uydurma veri konmaz)
FOOTBALL_DATA_TOKEN=
API_FOOTBALL_KEY=
ODDS_API_KEY=
THESPORTSDB_KEY=123

# Lig kodları: T1 (Süper Lig), E0, E1, SP1, I1, D1, F1, N1, P1
LEAGUES=T1,E0,SP1,I1,D1,F1

# Bot ayarları
BOT_HORIZON_HOURS=48
BOT_MIN_MINUTES_BEFORE_KICKOFF=15
COMPLETENESS_MIN=60
MIN_TEAM_MATCHES=4
VALUE_EDGE_MIN=0.03
NO_ODDS_MIN_PROB=0.72
COUPON_MIN_ODDS=2.30
COUPON_MAX_ODDS=4.00
COUPON_MIN_EV=0.0
CONSENSUS_MIN_SINGLES=5
REQUIRE_INJURY_DATA=false
API_FOOTBALL_DAILY_BUDGET=90

# Örnek veri modu (UYDURMA veri; yalnızca arayüzü denemek için). Gerçek kullanımda kapalı tutun.
DEMO_MODE=false
