# 90 Meclis — ortam değişkenleri örneği. Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# .env dosyası .gitignore'dadır; GERÇEK ANAHTARLARI DEPOYA KOYMAYIN.

# Supabase (Project Settings > API). Bot/GitHub Actions için service_role, herkese açık okuma için anon anahtarı.
SUPABASE_URL=https://<proje-ref>.supabase.co
SUPABASE_KEY=<service_role_veya_anon_anahtari>

# Veri kaynağı anahtarları — hepsi gerekli. Boş kalan kaynak atlanır ve arayüzde "anahtar bekleniyor" yazar
# (uydurma veri konmaz). Nereden alınır ve ücretsiz limitler: docs/kaynaklar.md
# https://dashboard.api-football.com/register  (100 istek/gün)
API_FOOTBALL_KEY=
# https://www.football-data.org/client/register (10 istek/dk)
FOOTBALL_DATA_TOKEN=
# https://the-odds-api.com/#get-access          (500 kredi/ay)
ODDS_API_KEY=
# https://oddspapi.io/en/register              (250 istek/ay)
ODDSPAPI_KEY=
# https://my.sportmonks.com/register           (ücretsiz plan: DK + SCO ligleri)
SPORTMONKS_KEY=
# https://footystats.org/api                   (ücretsiz: Premier Lig)
FOOTYSTATS_KEY=
# https://sportdevs.com/football               (300 istek/gün)
SPORTDEVS_KEY=
# http://clubelo.com/API                       (API kaydı açılınca)
CLUBELO_KEY=
# https://sports.bzzoiro.com/register/        (ücretsiz, kota yok: sakat/cezalı + resmî/tahmini ilk 11)
BSD_API_KEY=
# boşsa ücretsiz "123"; Patreon anahtarı: https://www.thesportsdb.com/pricing
THESPORTSDB_KEY=

# Lig kodları: T1 (Süper Lig), E0, E1, SP1, I1, D1, F1, N1, P1
# AUTO = BSD'nin verdiği diğer bütün kulüp ligleri/kupaları da otomatik eklenir (kod B<bsd_id>)
LEAGUES=T1,E0,SP1,I1,D1,F1,CL,EL,ECL,T2,E1,N1,P1,B1,SC0,G1,E2,SP2,I2,D2,F2,E3,SC1,AUTO
# BSD kota ayarları (günlük 7.500): çalışma başı istek tavanı, oran istenen ufuk (saat)
BSD_MAX_CALLS=1200
BSD_ODDS_HOURS=48

# Bot ayarları
# Bot: 7 günlük ufuktaki her maç analiz edilir; değer seçimi başlamadan en az 3 saat önce yayımlanır
BOT_HORIZON_HOURS=168
BOT_PUBLISH_LEAD_HOURS=3
BOT_PUBLISH_WINDOW_HOURS=12
# Canlı eksik/ilk 11 çağrıları yalnızca bu kadar saat içindeki maçlar için (uzaktakiler 'kadro' verisini kullanır)
BOT_LIVE_EXTRAS_HOURS=24
# Yayın için iki takımın modelde en az kaç maçı olmalı
MIN_TEAM_MATCHES=4
VALUE_EDGE_MIN=0.03
NO_ODDS_MIN_PROB=0.72
COUPON_MIN_ODDS=2.30
COUPON_MAX_ODDS=4.00
COUPON_MIN_EV=0.0
CONSENSUS_MIN_SINGLES=5
BOT_SINGLE_MIN_TRUST=0.04  # Meclis Görüşü için en az değer×kalite
REQUIRE_INJURY_DATA=false
API_FOOTBALL_DAILY_BUDGET=90

# Örnek veri modu (UYDURMA veri; yalnızca arayüzü denemek için). Gerçek kullanımda kapalı tutun.
DEMO_MODE=false
