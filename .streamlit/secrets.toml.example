# Streamlit Community Cloud > App > Settings > Secrets alanına yapıştırın (veya yerelde .streamlit/secrets.toml).
# Bu dosyanın gerçek kopyası (.streamlit/secrets.toml) .gitignore'dadır.
# Arayüz yalnızca OKUR: veri toplama ve tahmin defterine yazma GitHub Actions'taki bot (service_role) tarafından yapılır.
# Bu yüzden burada yalnızca iki değer gerekir ve SUPABASE_KEY anon (publishable) anahtarı olmalıdır — service_role ASLA.
SUPABASE_URL = "https://<proje-ref>.supabase.co"
SUPABASE_KEY = "<anon / publishable anahtar>"
# İsteğe göre: lig listesini değiştirmek için
# LEAGUES = "T1,E0,SP1,I1,D1,F1"
# Veri kaynağı anahtarları (BSD_API_KEY, API_FOOTBALL_KEY, ...) burada GEREKMEZ; GitHub Actions secret'larında durur.
